{
  "schema": 1,
  "name": "qwen38_flash_next",
  "version": "0.1.0",
  "api_version": ">= 0.3.0",
  "entry": "qwen38_flash_next_register",
  "registration_target": "gufo_qwen38_flash_next",
  "depends": [],
  "platforms": [
    "linux",
    "windows"
  ],
  "providers": [
    {
      "id": "flash-next-q4",
      "capability": "text_generation",
      "keys": [
        "gguf:qwen4exp"
      ],
      "model_ids": [
        "flash-next-q4"
      ],
      "speculative": [
        "mtp"
      ],
      "target": "gufo_qwen38_flash_next_hip",
      "entry": "qwen38_flash_next_provider_register",
      "serving": {
        "draft_options": {
          "mtp": "--mtp-model"
        }
      }
    }
  ],
  "models": [
    {
      "id": "flash-next-q4",
      "provider": "flash-next-q4",
      "license": "qwen-community-1.0",
      "description": "Qwen3.8 Flash-Next, UD-Q4_K_XL GGUF",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "unsloth/Qwen3.8-Flash-Next-GGUF",
            "revision": "d96201194f103c906994f283f504209dc8d2a10c"
          },
          "include": [
            "UD-Q4_K_XL/*"
          ],
          "entry": "UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf"
        },
        {
          "role": "mtp",
          "option": "--mtp-model",
          "install": "default",
          "source": {
            "hf": "unsloth/Qwen3.8-Flash-Next-GGUF",
            "revision": "d96201194f103c906994f283f504209dc8d2a10c"
          },
          "include": [
            "MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf"
          ]
        },
        {
          "role": "mmproj",
          "option": "--mmproj",
          "install": "default",
          "source": {
            "hf": "unsloth/Qwen3.8-Flash-Next-GGUF",
            "revision": "d96201194f103c906994f283f504209dc8d2a10c"
          },
          "include": [
            "mmproj-BF16.gguf"
          ]
        }
      ]
    }
  ],
  "options": [
    {
      "name": "--mtp-model",
      "type": "path",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "MTP draft model path for speculative decoding"
    },
    {
      "name": "--memory-budget-gb",
      "type": "number",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Qwen3.8-Flash-Next memory budget in GiB (default: off)"
    },
    {
      "name": "--ple-shelf",
      "type": "boolean",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Cache PLE rows in a 128 MiB bounded RAM shelf"
    },
    {
      "name": "--ple-shelf-mib",
      "type": "integer",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "PLE shelf size in MiB (0 disables; default: 128)"
    },
    {
      "name": "--prefetch-layers-ahead",
      "type": "integer",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Token-prior prefetch horizon in layers (default: 2)"
    },
    {
      "name": "--ssd-stats",
      "type": "boolean",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Print SSD, cache, memory and session-write telemetry"
    },
    {
      "name": "--cache-prior-bias",
      "type": "number",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Weight learned expert priors in cache retention (default: 0)"
    },
    {
      "name": "--cache-policy",
      "type": "string",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Expert cache victim policy: lru, hotness, or decayed (default: lru)"
    },
    {
      "name": "--cache-slot-profile",
      "type": "string",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Per-layer cache slots: uniform, skewed, or a JSON profile path (default: skewed)"
    },
    {
      "name": "--cache-router-bonus",
      "type": "number",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Raw-logit residency bonus for router selection (default: 0)"
    },
    {
      "name": "--cache-router-bonus-core",
      "type": "integer",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Keep the N highest-logit experts unbiased (default: 0)"
    },
    {
      "name": "--cache-router-bonus-skip-layers",
      "type": "integer",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Skip the residency bonus for the first N layers (default: 0)"
    },
    {
      "name": "--shadow-prefetch-streak",
      "type": "integer",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Prefetch experts overridden by the residency bonus after appearing in this many MTP rows (0 disables; default: 0)"
    },
    {
      "name": "--shadow-prefetch-max-rank",
      "type": "integer",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Highest unbiased raw-router rank eligible for shadow prefetch (default: 1)"
    },
    {
      "name": "--mtp-verify-acceptance-floor",
      "type": "number",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Verify MTP drafts only while each draft's live acceptance confidence reaches FLOAT; 0 verifies the full chain (default: 0)"
    },
    {
      "name": "--dump-routing",
      "type": "path",
      "commands": [
        "serve",
        "bench",
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Write a binary GURT expert-routing trace"
    },
    {
      "name": "--prompt-lookup",
      "type": "boolean",
      "commands": [
        "prompt",
        "chat"
      ],
      "providers": [
        "flash-next-q4"
      ],
      "help": "Allow repeated committed text to fill remaining MTP draft slots"
    }
  ],
  "targets": {
    "gufo_qwen38_flash_next": {
      "requires": []
    },
    "gufo_qwen38_flash_next_hip": {
      "requires": [
